set shell := ["bash", "-cu"]

import '../../../.just/lib.just'

url := "http://localhost:8080/v1"
duration := "5s"
result_file := "result.bin"
id_file := "id.txt"
batch_size := "10"
total_records := "500"

[doc('Show available load test recipes')]
default:
    just --list

[doc('Remove generated load test artifacts')]
clean-file:
    just _title "CLEAN" "Removing load test artifacts"
    rm -f {{id_file}} {{result_file}}

[doc('Run the read load test')]
load-read:
    just _title "LOAD" "Get Load Test"
    URL="{{url}}" jq -R -ncM 'inputs as $id | {method: "GET", url: "\(env.URL)/student/\($id)"}' < {{id_file}} | vegeta attack -format=json -duration={{duration}} | vegeta report

[doc('Run the list load test')]
load-list:
    just _title "LOAD" "List Load Test"
    URL="{{url}}" BATCH_SIZE="{{batch_size}}" TOTAL_RECORDS="{{total_records}}" jq -ncM 'range(0; env.TOTAL_RECORDS | tonumber; env.BATCH_SIZE | tonumber) | {method: "GET", url: "\(env.URL)/student?offset=\(. | tostring)&limit=\(env.BATCH_SIZE)&sort_by=name&order=asc"}' | vegeta attack -format=json -duration={{duration}} | vegeta report

[doc('Run the write load test')]
load-write:
    #!/usr/bin/env bash
    set -euo pipefail
    just _title "LOAD" "Write Load Test"
    id_file={{quote(id_file)}}
    result_file={{quote(result_file)}}
    target_file=$(mktemp)
    filtered_result_file=$(mktemp "${result_file}.filtered.XXXXXX")
    trap 'rm -f "$target_file" "$filtered_result_file"' EXIT
    rm -f "$id_file" "$result_file"
    URL={{quote(url)}} TOTAL_RECORDS={{quote(total_records)}} jq -ncM --slurpfile a payload.json \
        'range(0; (env.TOTAL_RECORDS | tonumber)) as $i | $a[0] | .name="\(.name)-\($i)" | {method: "POST", header: {"Content-Type": ["application/json"]}, url: "\(env.URL)/student", body: . | @base64}' \
        > "$target_file"
    vegeta attack -lazy -format=json -duration={{duration}} -targets="$target_file" -output="$result_file"
    # Vegeta emits a code-0 sentinel when a finite target file runs out.
    vegeta encode "$result_file" | jq -c 'select(.code != 0 or .error != "no targets to attack")' | vegeta encode -to gob > "$filtered_result_file"
    mv "$filtered_result_file" "$result_file"
    just _detail "LOAD" "Extracting IDs"
    vegeta encode "$result_file" | jq -ers 'map(select(.code == 201)) as $created | [$created[] | (.body | @base64d | fromjson | .data.id)] as $ids | if ($created | length) == 0 or any($ids[]; if type == "string" then (gsub("[[:space:]]"; "") | length == 0) else true end) then error("201 create response missing nonempty data.id") else $ids[] end' > "$id_file"
    test -s "$id_file"
    just _detail "LOAD" "Test Result"
    vegeta report "$result_file"

[group('run')]
[doc('Run the full load workflow')]
load: load-write load-list load-read

[doc('Show load test configuration')]
info-load:
    just _title "INFO" "Load Info"
    just _info "INFO" "URL: {{url}}"
    just _info "INFO" "DURATION: {{duration}}"
    just _info "INFO" "BATCH_SIZE: {{batch_size}}"
    just _info "INFO" "TOTAL_RECORDS: {{total_records}}"

[group('info')]
[doc('Show load test information')]
info: info-load

[group('info')]
[doc('Show extended load test information')]
infos: info

[doc('Onetime setup hook')]
prepare:
    @:

[group('setup')]
[doc('Run the load test setup and workload')]
setup: info load

[group('setup')]
[doc('Clean load test artifacts')]
clean: clean-file

[group('setup')]
[doc('Reset load test state')]
reset: setup clean

[group('setup')]
[doc('Run the complete load test workflow')]
all: prepare reset
