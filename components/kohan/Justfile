set shell := ["bash", "-cu"]

# Import shared library
import '../../.just/lib.just'

binary := root + "/bin/kohan"
port := "9091"
kohan_dir := justfile_directory()
pics_dir := "/tmp/pics"
barkat_db_path := "/tmp/barkat.db"

[doc('Show available Kohan recipes')]
default:
    just --list

# Build Kohan binary.
[doc('Build the Kohan binary and UI assets')]
[group('build')]
build: _templ _css _format _js build-bin
    just _title "BUILD" "Kohan Ready"

[doc('Build the Kohan binary without regenerating UI assets')]
[group('build')]
build-bin:
    mkdir -p {{root}}/bin
    CGO_ENABLED=1 GOARCH=amd64 go build -o {{binary}} .

[doc('Install the Kohan CLI locally')]
[group('setup')]
install:
    just _title "Installing" "Kohan"
    CGO_ENABLED=1 GOARCH=amd64 go install .

# Run Kohan server with Air hot reload.
[doc('Run Kohan with Air hot reload')]
[group('run')]
air: kill-server
	mkdir -p {{pics_dir}}
	SERVER_PORT="{{port}}" BARKAT_DB_PATH="{{barkat_db_path}}" BARKAT_IMAGE_PATH="{{pics_dir}}" KOHAN_BINARY="{{binary}} auto serve" just _air-run {{kohan_dir}} {{port}}

[doc('Kill Kohan server on the configured port')]
[group('run')]
kill-server:
	pkill air 2>/dev/null || true
	lsof -ti :{{port}} | xargs -r kill 2>/dev/null || true
