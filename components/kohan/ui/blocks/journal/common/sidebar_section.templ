package common

import (
	"github.com/templui/templui/components/icon"
)

templ JournalDetailSection(title string, description string, openExpr string, toggleExpr string) {
	<details class="rounded-3xl border border-border bg-card shadow-sm" x-bind:open={ openExpr } x-on:toggle={ toggleExpr }>
		<summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-3 py-2.5 outline-none transition hover:bg-muted/40 focus-visible:ring-2 focus-visible:ring-violet-300">
			<div class="space-y-1">
				<h3 class="text-sm sm:text-base font-semibold tracking-tight text-foreground">{ title }</h3>
				<p class="text-xs leading-snug text-muted-foreground" x-show={ openExpr }>{ description }</p>
			</div>
			<span class="mt-0.5 shrink-0 text-muted-foreground transition-transform" x-bind:class={ openExpr + " ? 'rotate-180' : ''" } aria-hidden="true">
				@icon.Icon("chevron-down")(icon.Props{Class: "size-4"})
			</span>
		</summary>
		<div class="border-t border-border px-3 pb-3 pt-3 space-y-3">
			{ children... }
		</div>
	</details>
}
