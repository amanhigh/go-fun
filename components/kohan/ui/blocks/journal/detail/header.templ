package detail

import (
	journalcommon "github.com/amanhigh/go-fun/components/kohan/ui/blocks/journal/common"
	"github.com/amanhigh/go-fun/components/kohan/ui/components"
	"github.com/templui/templui/components/badge"
	"github.com/templui/templui/components/icon"
)

// ============================================================
// HEADER FLOW
// ============================================================

templ JournalDetailHeader() {
	<div class="journal-detail-header w-full space-y-3">
		<template x-if="journal.detail">
			<div class="space-y-3">
				<div class="grid items-center gap-4 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
					<div class="flex flex-col items-center gap-2 lg:col-start-2">
						<h2 class="text-3xl font-bold tracking-tight text-foreground" x-text="journal.detail.ticker"></h2>
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "border-violet-300 bg-violet-100 text-violet-700 shadow-sm"}) {
							Journal ID:
							<span x-text="journal.detail.id"></span>
						}
					</div>
					<div class="flex flex-col items-end gap-2 lg:col-start-3">
						@JournalDetailCreatedAt()
						<div class="flex items-center gap-2">
							@components.Submitter(components.SubmitterProps{
								Submitter: "header.submitter",
							})
							@components.DeleteButton(components.DeleteButtonProps{
								Label:        "Delete Journal",
								DisabledExpr: "header.submitter.isBusy()",
								OnClickExpr:  "header.deleteJournal()",
								Class:        "h-9 w-9",
							})
						</div>
					</div>
				</div>
				<div class="journal-detail-header-meta flex flex-wrap items-center gap-x-6 gap-y-3">
					<div class="flex flex-wrap items-center gap-2.5">
						@journalcommon.TypeBadge(journalcommon.TypeBadgeProps{TypeExpr: "journal.detail.type", Class: "rounded-full px-3 py-1 text-sm font-semibold shadow-sm"})
						@journalcommon.StatusBadge(journalcommon.StatusBadgeProps{StatusExpr: "journal.detail.status", Class: "rounded-full px-3 py-1 text-sm font-semibold shadow-sm"})
						@JournalDetailTopTimeframeChip()
					</div>
					<div class="flex flex-wrap items-center gap-2" x-show="sidebar.tags.all().length">
						<span class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Tags</span>
						@JournalDetailReasonTags()
						@JournalDetailDirectionalTags()
					</div>
				<div class="min-w-0 flex-1 truncate text-sm italic text-muted-foreground" title="ਜਿਹੜੇ ਲੋਕ ਇਤਿਹਾਸ ਨੂੰ ਯਾਦ ਨਹੀਂ ਰੱਖਦੇ, ਉਹ ਇਸਨੂੰ ਦੁਹਰਾਉਣ ਲਈ ਸਰਾਪੇ ਜਾਂਦੇ ਹਨ। – ਜਾਰਜ ਸਾਂਤਾਯਾਨਾ">
					ਜਿਹੜੇ ਲੋਕ ਇਤਿਹਾਸ ਨੂੰ ਯਾਦ ਨਹੀਂ ਰੱਖਦੇ, ਉਹ ਇਸਨੂੰ ਦੁਹਰਾਉਣ ਲਈ ਸਰਾਪੇ ਜਾਂਦੇ ਹਨ। – ਜਾਰਜ ਸਾਂਤਾਯਾਨਾ
				</div>
				<div class="flex flex-col items-end gap-2 lg:ml-auto">
					<div class="flex items-center gap-2">
						@JournalDetailPendingDate()
						@JournalDetailReviewDate()
					</div>
					@journalDetailReviewCard()
				</div>
				</div>
			</div>
		</template>
	</div>
}

templ JournalDetailCreatedAt() {
	<div class="flex items-center gap-1 text-sm text-muted-foreground text-xs">
		@icon.Icon("clock")(icon.Props{Class: "size-4"})
		<span x-text="present.date.format(journal.detail.created_at)"></span>
	</div>
}

templ JournalDetailReviewDate() {
	@components.FilterChip(components.FilterChipProps{ShowExpr: "journal.detail.reviewed_at", TextExpr: "present.review.label(journal.detail.reviewed_at)", Tone: components.ToneGreen, Class: "rounded-full px-3 py-1 text-sm font-semibold shadow-sm"})
}

templ JournalDetailPendingDate() {
	@components.FilterChip(components.FilterChipProps{ShowExpr: "!journal.detail.reviewed_at", TextExpr: "present.review.label(journal.detail.reviewed_at)", Tone: components.ToneAmber, Class: "rounded-full px-3 py-1 text-sm font-semibold shadow-sm"})
}

templ JournalDetailTopTimeframeChip() {
	@components.FilterChip(components.FilterChipProps{TextExpr: "present.timeframe.label(journal.detail.top_timeframe)", Tone: components.ToneViolet, Class: "rounded-full px-3 py-1 text-sm font-semibold shadow-sm"})
}

templ JournalDetailReasonTags() {
	<div class="flex flex-wrap gap-2">
		<template x-for="tag in sidebar.tags.reason()" x-bind:key="tag.id">
			@components.FilterChip(components.FilterChipProps{Tone: components.ToneAmber, Class: "rounded-full font-semibold", TextExpr: "present.tag.label(tag)"})
		</template>
		<template x-for="tag in sidebar.tags.management()" x-bind:key="tag.id">
			@components.FilterChip(components.FilterChipProps{Tone: components.ToneViolet, Class: "rounded-full font-semibold", TextExpr: "present.tag.label(tag)"})
		</template>
	</div>
}

templ JournalDetailDirectionalTags() {
	<div class="flex flex-wrap gap-2">
		<template x-for="tag in sidebar.tags.directional()" x-bind:key="tag.id">
			@components.FilterChip(components.FilterChipProps{Tone: components.ToneSlate, Class: "rounded-full text-xs", TextExpr: "present.tag.label(tag)"})
		</template>
	</div>
}

// journalDetailReviewCard renders the review action bar and the submitter
// spinner. The conditional advance to the next journal after a review is owned
// by the shared notification runtime (sidebar.state.reviewAdvance), so no
// inline deferred-action banner is rendered here.
templ journalDetailReviewCard() {
	<div>
		@journalDetailActionBar()
		@components.Submitter(components.SubmitterProps{Submitter: "sidebar.reviewBar.submitter"})
	</div>
}

templ journalDetailActionBar() {
	@components.QuickBar(components.QuickBarProps{
		Label:    "Review",
		IconName: "clipboard-check",
		Theme:    components.ToneGreen,
		Class:    "rounded-2xl border border-border bg-muted/30 px-4 py-3",
	}) {
		<template x-for="action in sidebar.reviewBar.actions()" x-bind:key="action.id">
			@components.QuickAction(components.QuickActionProps{
				OnClickExpr:  "action.apply()",
				TextExpr:     "sidebar.reviewBar.submitter.isBusy() ? 'Saving...' : action.display.text",
				ClassExpr:    "action.display.class",
				DisabledExpr: "sidebar.reviewBar.submitter.isBusy()",
			})
		</template>
	}
}
