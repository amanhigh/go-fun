package components

import (
	"github.com/amanhigh/go-fun/common/ui/widgets"
)

// ============================================================
// SUBMITTER WRAPPER
// ============================================================
// Shows a spinner during submission. Success and error feedback is
// surfaced by the shared notification runtime (notify) via the
// Submitter JS concern, so no inline statebox is rendered here.
// Submitter is the JS expression for the submitter state object (e.g. "header.submitter").

type SubmitterProps struct {
	Submitter string
}

templ Submitter(props SubmitterProps) {
	@widgets.Spinner(widgets.SpinnerProps{
		Size: widgets.SpinnerSizeSm,
		Attrs: templ.Attributes{
			"x-show": props.Submitter + ".isBusy()",
		},
	})
}
