package widgets

import (
	"github.com/templui/templui/components/alert"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/icon"
)

// Notification renders the single, prop-free notification viewport. It is
// mounted exactly once (typically from the shared base layout) and provides
// accessible live feedback via an aria-live region. Runtime behavior (queue,
// timers, dismissal, actions, expiry) is provided by Kohan's JS bundle
// (notification runtime bundled via esbuild), not by an inline script here.
//
// Variant icons and the optional action button are rendered here as TemplUI
// scaffolds with static classes so Tailwind can scan them; the runtime selects
// the active variant icon and clones the action scaffold via data attributes.
//
// Presentation lives in the shared notification stylesheet, imported by Kohan;
// the template carries only stable semantic hooks (notification-viewport,
// notification-card, notification-icon, notification-title, notification-message,
// notification-action, notification-dismiss) plus data-variant selectors.
templ Notification() {
	<div
		data-notification-viewport
		aria-live="polite"
		role="region"
		aria-label="Notifications"
		class="notification-viewport"
	>
		<template data-notification-template>
			@alert.Alert(alert.Props{
				Variant: alert.VariantDefault,
				Class: "notification-card",
			}) {
				<span data-variant-icon="success" hidden aria-hidden="true" class="notification-icon">@icon.Icon("circle-check")(icon.Props{Class: "size-4"})</span>
				<span data-variant-icon="error" hidden aria-hidden="true" class="notification-icon">@icon.Icon("circle-x")(icon.Props{Class: "size-4"})</span>
				<div class="notification-content">
					<div class="notification-body">
						<h5
							data-notification-title
							class="notification-title"
							hidden
						></h5>
						<div
							data-notification-message
							class="notification-message"
						></div>
					</div>
					<div class="notification-controls">
						<div data-notification-action>
							@button.Button(button.Props{
								Size:    button.SizeSm,
								Variant: button.VariantSecondary,
								Class: "notification-action",
								Attributes: templ.Attributes{
									"type":                        "button",
									"data-notification-action-scaffold": "",
									"hidden":                      "",
								},
							}) {
								<span data-notification-action-label></span>
							}
						</div>
						@button.Button(button.Props{
							Size:    button.SizeIcon,
							Variant: button.VariantGhost,
							Class: "notification-dismiss",
							Attributes: templ.Attributes{
								"type":                    "button",
								"aria-label":              "Dismiss",
								"data-notification-dismiss": "",
							},
						}) {
							@icon.Icon("x")(icon.Props{Class: "size-4"})
						}
					</div>
				</div>
			}
		</template>
	</div>
}
